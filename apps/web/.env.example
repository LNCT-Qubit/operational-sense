# Leave empty in development: the Vite dev server proxies /api to the backend.
# Set to the backend's public URL for a deployed build (e.g. https://api.example.com) and add this site's
# origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api (development only). Defaults to http://localhost:3000.
VITE_DEV_API_TARGET=
