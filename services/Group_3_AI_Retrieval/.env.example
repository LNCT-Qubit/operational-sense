# Copy to .env (never commit .env) and replace every placeholder.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_superuser_password
POSTGRES_DB=opsense
DB_HOST=localhost
DB_PORT=5432
# Application role (created by database/migrations/007 WITHOUT a password). Choose a strong value (>= 12 chars)
# and apply it with database/scripts/set_app_password.sh, which reads it from this file's environment.
OPSENSE_APP_USER=opsense_app
OPSENSE_APP_PASSWORD=CHANGE_ME_app_role_password
# Demo tenant UUID created by database/seed_data/005 (synthetic tenant)
OPSENSE_ORG_ID=b2a7dce7-b449-4381-ba3b-b520f2c88c2e
# Embedding settings (PROVISIONAL)
OPSENSE_EMBEDDING_PROVIDER=sentence-transformers
OPSENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPSENSE_EMBEDDING_DIM=384
OPSENSE_EMBEDDING_QUERY_PREFIX="query: "
OPSENSE_EMBEDDING_DOCUMENT_PREFIX="passage: "
# OPSENSE_MIN_SIMILARITY=   # leave unset until a cut-off is approved
