# Copy to .env (never commit). Variables marked REQUIRED have no safe default.
PORT=3000
# REQUIRED. Must connect as the application role (opsense_app), NOT postgres: a superuser/BYPASSRLS role skips RLS.
# The server refuses to start if the role is superuser or BYPASSRLS.
DATABASE_URL=postgresql://opsense_app:CHANGE_ME@localhost:5432/opsense
# REQUIRED, >= 32 chars. HS256 secret used to verify bearer tokens (see docs/06-api-and-integration/us-07/).
JWT_SECRET=
# Where uploaded audio is stored (outside the repo). The transcription service must be able to read it.
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=15728640
# Formats the upload endpoint accepts. Default = what US-05 can actually decode. See cross-team issue
# "WebM/M4A" in the US-07 handoff before adding audio/webm or audio/mp4 here.
ALLOWED_AUDIO_MIME=audio/wav,audio/x-wav,audio/wave,audio/mpeg,audio/flac,audio/x-flac,audio/ogg
# Start processing automatically after upload (true) or only on POST /recordings/:id/process (false).
AUTO_PROCESS=true
STALE_CLAIM_SECONDS=600
MAX_TRANSCRIPTION_ATTEMPTS=3
# US-05 HTTP wrapper (services/ai-engine: python -m app.transcription.server)
TRANSCRIBER_URL=http://127.0.0.1:8000
TRANSCRIBER_TIMEOUT_MS=120000
TRANSCRIBER_INTERNAL_TOKEN=
# US-06 extraction (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
LOG_LEVEL=info
# Public signup (POST /api/v1/auth/signup)
# Organization new users join. Must exist in the organization table (migration 010 seeds 'Demo Org').
SIGNUP_ORG_NAME=Demo Org
# bcrypt cost factor (10-15). 12 is a good default; higher = slower hashing = harder to brute-force.
BCRYPT_ROUNDS=12
# Browser origins allowed to call the API directly (comma-separated, no wildcard). Leave empty when using the Vite dev proxy.
CORS_ALLOWED_ORIGINS=
