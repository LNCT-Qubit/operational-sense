{
  "name": "@operational-sense/backend",
  "version": "0.2.0",
  "private": true,
  "description": "Operational Sense backend (Express + TypeScript): capture pipeline recording -> transcription -> extraction draft (US-07)",
  "main": "dist/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:us06": "node --test src/modules/extraction/test-draft-workflow.js src/modules/extraction/test-postgres-store.test.js"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
