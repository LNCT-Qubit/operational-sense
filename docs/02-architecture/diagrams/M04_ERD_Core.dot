digraph Core {
graph [bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.7", splines=ortho, fontname="Arial", labelloc="t", labeljust="l", fontsize=20, fontcolor="#1F4E5F"];
node [shape=plain, fontname="Arial", fontsize=9]; edge [fontname="Arial", fontsize=8, color="#506A78", fontcolor="#314A56", arrowsize=0.65];
label="Operational Sense — Core logical model (M04 v1.2; canonical entity names)";
subgraph cluster_asset { label="Plant asset hierarchy"; color="#B8CDD5"; style="rounded";
ASSET_NODE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>ASSET_NODE</B></TD></TR><TR><TD ALIGN="LEFT">PK asset_id</TD></TR><TR><TD ALIGN="LEFT">FK parent_asset_id (nullable)</TD></TR><TR><TD ALIGN="LEFT">FK equipment_class_id (optional)</TD></TR><TR><TD ALIGN="LEFT">asset_level, asset_name, status</TD></TR><TR><TD ALIGN="LEFT">model_label, model_is_illustrative</TD></TR></TABLE> >];
EQUIPMENT_CLASS [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>EQUIPMENT_CLASS</B></TD></TR><TR><TD ALIGN="LEFT">PK equipment_class_id</TD></TR><TR><TD ALIGN="LEFT">class_name, review_status</TD></TR></TABLE> >];
ASSET_NODE -> ASSET_NODE [label="parent-child (self FK)"];
ASSET_NODE -> EQUIPMENT_CLASS [label="0..1 class per node", dir=back]; }
subgraph cluster_case { label="Troubleshooting knowledge"; color="#B8CDD5"; style="rounded";
TROUBLESHOOTING_CASE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>TROUBLESHOOTING_CASE</B></TD></TR><TR><TD ALIGN="LEFT">PK case_id</TD></TR><TR><TD ALIGN="LEFT">FK equipment_class_id; FK asset_id nullable</TD></TR><TR><TD ALIGN="LEFT">case_title, symptoms/conditions</TD></TR><TR><TD ALIGN="LEFT">suspected cause, action, status</TD></TR><TR><TD ALIGN="LEFT">retrieval_eligibility, case_origin</TD></TR></TABLE> >];
CASE_SYMPTOM [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_SYMPTOM</B></TD></TR><TR><TD ALIGN="LEFT">PK case_symptom_id</TD></TR><TR><TD ALIGN="LEFT">FK case_id</TD></TR><TR><TD ALIGN="LEFT">symptom_category, symptom_text</TD></TR></TABLE> >];
DIAGNOSTIC_STEP [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>DIAGNOSTIC_STEP</B></TD></TR><TR><TD ALIGN="LEFT">PK diagnostic_step_id; FK case_id</TD></TR><TR><TD ALIGN="LEFT">step_number, tier, question</TD></TR><TR><TD ALIGN="LEFT">check_measurement, expected_observation</TD></TR><TR><TD ALIGN="LEFT">UNIQUE(case_id, step_number)</TD></TR></TABLE> >];
FAILURE_MODE_TAXONOMY [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>FAILURE_MODE_TAXONOMY</B></TD></TR><TR><TD ALIGN="LEFT">PK taxonomy_code</TD></TR><TR><TD ALIGN="LEFT">FK equipment_class_id</TD></TR><TR><TD ALIGN="LEFT">subsystem, component, failure_mode_name</TD></TR><TR><TD ALIGN="LEFT">review_status</TD></TR></TABLE> >];
FAILURE_MODE_VOCABULARY [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>FAILURE_MODE_VOCABULARY</B></TD></TR><TR><TD ALIGN="LEFT">PK failure_mode_id</TD></TR><TR><TD ALIGN="LEFT">preferred_label, review_status</TD></TR></TABLE> >];
CASE_FAILURE_MAPPING [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_FAILURE_MAPPING</B></TD></TR><TR><TD ALIGN="LEFT">PK mapping_id; FK case_id</TD></TR><TR><TD ALIGN="LEFT">FK taxonomy_code nullable</TD></TR><TR><TD ALIGN="LEFT">FK failure_mode_id nullable</TD></TR><TR><TD ALIGN="LEFT">mapping_status, is_primary, review_note</TD></TR></TABLE> >];
TROUBLESHOOTING_CASE -> CASE_SYMPTOM [label="1 to 1..many"];
TROUBLESHOOTING_CASE -> DIAGNOSTIC_STEP [label="1 to 1..many"];
TROUBLESHOOTING_CASE -> CASE_FAILURE_MAPPING [label="1 to 0..many"];
FAILURE_MODE_TAXONOMY -> CASE_FAILURE_MAPPING [label="0..1 target"];
FAILURE_MODE_VOCABULARY -> CASE_FAILURE_MAPPING [label="0..1 target"];
EQUIPMENT_CLASS -> TROUBLESHOOTING_CASE [label="1 to 0..many"];
}
}