digraph References {
graph [bgcolor="white", pad="0.35", nodesep="1.0", ranksep="1.15", splines=polyline, fontname="Arial", labelloc="t", labeljust="l", fontsize=20, fontcolor="#1F4E5F"];
node [shape=plain, fontname="Arial", fontsize=9]; edge [fontname="Arial", fontsize=8, color="#506A78", fontcolor="#314A56", arrowsize=0.65];
label="Operational Sense — Provenance, safety and review model (M04 v1.2; canonical entity names)";
TROUBLESHOOTING_CASE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>TROUBLESHOOTING_CASE</B></TD></TR><TR><TD ALIGN="LEFT">PK case_id</TD></TR></TABLE> >];
SOURCE_REFERENCE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>SOURCE_REFERENCE</B></TD></TR><TR><TD ALIGN="LEFT">PK source_id</TD></TR><TR><TD ALIGN="LEFT">title, publisher, identifier, version</TD></TR><TR><TD ALIGN="LEFT">url, reliability, verification_status</TD></TR></TABLE> >];
CASE_SOURCE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_SOURCE</B></TD></TR><TR><TD ALIGN="LEFT">Composite PK/FK case_id + source_id</TD></TR><TR><TD ALIGN="LEFT">relation_note, evidence_role</TD></TR></TABLE> >];
SPARE_PART_REFERENCE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>SPARE_PART_REFERENCE</B></TD></TR><TR><TD ALIGN="LEFT">PK spare_part_id</TD></TR><TR><TD ALIGN="LEFT">part_name, function, compatibility_note</TD></TR><TR><TD ALIGN="LEFT">FK source_id nullable</TD></TR></TABLE> >];
CASE_SPARE_PART [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_SPARE_PART</B></TD></TR><TR><TD ALIGN="LEFT">Composite PK/FK case_id + spare_part_id</TD></TR><TR><TD ALIGN="LEFT">usage_note</TD></TR></TABLE> >];
SAFETY_PROCEDURE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>SAFETY_PROCEDURE</B></TD></TR><TR><TD ALIGN="LEFT">PK safety_procedure_id</TD></TR><TR><TD ALIGN="LEFT">equipment_class_id nullable; hazard, requirement</TD></TR><TR><TD ALIGN="LEFT">scope_type, source_id nullable</TD></TR></TABLE> >];
CASE_SAFETY_PROCEDURE [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_SAFETY_PROCEDURE</B></TD></TR><TR><TD ALIGN="LEFT">Composite PK/FK case_id + safety_procedure_id</TD></TR><TR><TD ALIGN="LEFT">application_note</TD></TR></TABLE> >];
CASE_VERIFICATION [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#DCE9ED"><B>CASE_VERIFICATION</B></TD></TR><TR><TD ALIGN="LEFT">PK verification_id; FK case_id</TD></TR><TR><TD ALIGN="LEFT">reviewer, review_date, technical/taxonomy/source/safety status</TD></TR><TR><TD ALIGN="LEFT">overall_decision, comments</TD></TR></TABLE> >];
TROUBLESHOOTING_CASE -> CASE_SOURCE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
SOURCE_REFERENCE -> CASE_SOURCE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
TROUBLESHOOTING_CASE -> CASE_SPARE_PART [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
SPARE_PART_REFERENCE -> CASE_SPARE_PART [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
TROUBLESHOOTING_CASE -> CASE_SAFETY_PROCEDURE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
SAFETY_PROCEDURE -> CASE_SAFETY_PROCEDURE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
TROUBLESHOOTING_CASE -> CASE_VERIFICATION [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">1 to 0..many</TD></TR></TABLE>>];
SOURCE_REFERENCE -> SPARE_PART_REFERENCE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">0..1 source</TD></TR></TABLE>>, style=dashed];
SOURCE_REFERENCE -> SAFETY_PROCEDURE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="white">0..1 source</TD></TR></TABLE>>, style=dashed];
}
